/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vartifact.cc",
      "custom_domain": true,
    },
  ],
  "cache": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-emdash",
      "database_id": "3c199b92-6b7c-45da-8d01-669ebdb3bc20",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "blog-emdash-media",
    },
  ],
  "triggers": {
    "crons": ["* * * * *", "*/2 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.01,
    },
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true,
        },
        "traces": {
          "enabled": true,
          "persist": true,
          "head_sampling_rate": 1,
        },
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-emdash-preview",
          "database_id": "74dc908b-e831-45ff-9274-e6f1f450b4bc",
          "remote": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "blog-emdash-media-preview",
          "remote": true,
        },
      ],
    },
  },
  /**
   * Secrets (set via `wrangler secret put`):
   * - EMDASH_ENCRYPTION_KEY
   */
}

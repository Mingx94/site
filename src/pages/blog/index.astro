---
import PostList from "@/components/blog/PostList.astro";
import { getPosts } from "@/lib/posts";
import Base from "@/layouts/Base.astro";
const posts = await getPosts();
---
<Base title="文章 | Vartifact" description="閱讀 Vartifact 的文章，記錄程式、設計與生活。">
  <section class="writing" aria-labelledby="writing-label">
    <h1 class="section-label" id="writing-label">文章 · {posts.length} 篇</h1>
    {posts.length ? <div class="timeline"><PostList posts={posts} /></div> : <p class="empty-state">目前沒有公開文章。</p>}
  </section>
</Base>
<style>
	.writing {
		margin-bottom: 96px;
	}

	.pagination {
		grid-column: 2;
		margin-top: 8px;
		display: flex;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
	}
	.pag-link {
		display: inline-block;
		padding: 8px 4px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.pag-link.prev {
		margin-right: auto;
	}
	.pag-link.next {
		margin-left: auto;
	}
	.pag-link:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.pag-link:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.pagination {
			margin-top: 16px;
		}
	}

	@media (max-width: 420px) {
		.writing {
			margin-bottom: 64px;
		}
	}
</style>

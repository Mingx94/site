---
import ArticleClient from "@/components/ArticleClient.svelte";
import BackToPrev from "@/components/BackToPrev.svelte";
import BackToTop from "@/components/BackToTop.svelte";
import Container from "@/components/Container.svelte";
import FormattedDate from "@/components/FormattedDate.svelte";
import PostCover from "@/components/PostCover.svelte";
import ReactionBar from "@/components/ReactionBar.svelte";
import TableOfContents from "@/components/TableOfContents.svelte";
import Base from "@/layouts/Base.astro";
import { getPost } from "@/lib/posts";
import { getViews } from "@/lib/server/blog";
import { env } from "cloudflare:workers";
import { PortableText } from "emdash/ui";

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/404");
const post = await getPost(slug);
if (!post) return Astro.redirect("/404");
const views = await getViews(env.BLOG_KV, slug);
const formatStamp = (value?: string) => value?.slice(0, 10).replaceAll("-", ".") ?? "";
---

<Base
  title={`${post.title} | Vartifact`}
  description={post.description}
  image={post.cover}
  type="article"
  markdown={`/blog/${slug}.md`}
>
  <ArticleClient slug={slug} readingTime={post.readingTime} draft={post.draft} client:load />
  <Container>
    <div class="article-layout">
      <article>
        <div class="strip animate">
          <span>· Essay · {formatStamp(post.date)}</span>
          {post.draft && <span class="draft">Draft</span>}
        </div>
        <div class="title-block">
          <h1 class="page-title animate">{post.title}</h1>
          {post.description && <p class="introduction animate">{post.description}</p>}
        </div>
        <div class="byline animate">
          <span>By Michael Tsai</span>
          <div class="byline-meta">
            <FormattedDate date={post.date} />
            <span aria-hidden="true">·</span>
            <span>{post.readingTime} min read</span>
            <span aria-hidden="true">·</span>
            <span>{views} views</span>
          </div>
        </div>
        <PostCover slug={slug} title={post.title} src={post.cover} priority />
        <div class="animate content">
          <PortableText value={post.content} />
        </div>
        <ReactionBar slug={slug} client:load />
        <div class="colophon">
          <span>Filed {formatStamp(post.date)}</span>
          {post.updated && <span>Revised {formatStamp(post.updated)}</span>}
        </div>
      </article>
      <TableOfContents client:load />
    </div>
    <div class="back-links animate">
      <BackToPrev client:load />
      <BackToTop />
    </div>
  </Container>
</Base>

<style>
  article { min-width: 0; padding-top: 1rem; }
  .strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font: 11px var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .draft { color: var(--destructive); }
  .title-block { margin-block: 2rem 2.5rem; }
  .title-block > * + * { margin-top: 1.5rem; }
  .page-title {
    color: var(--foreground);
    font: 500 clamp(2.25rem, 6vw, 4.5rem)/1.05 var(--font-serif);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .introduction {
    max-width: 42rem;
    color: var(--muted-foreground);
    font: 1.125rem/1.625 var(--font-serif);
  }
  .byline,
  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .byline {
    gap: 0.5rem 1.5rem;
    margin-bottom: 3rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--border);
    font-size: 11px;
  }
  .byline-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; }
  .content { margin-top: 3rem; }
  .colophon {
    row-gap: 0.5rem;
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 10px;
  }
  .back-links { display: flex; margin-top: 3rem; }
  @media (width >= 48rem) {
    article { padding-top: 2rem; }
    .title-block { margin-block: 3rem 3.5rem; }
    .introduction { font-size: 1.25rem; }
    .byline { margin-bottom: 4rem; }
  }
  @media (width >= 96rem) {
    .article-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: 2rem;
      align-items: start;
    }
  }
</style>

---
import ArticleClient from "@/components/ArticleClient.astro";
import Container from "@/components/Container.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PostCover from "@/components/PostCover.astro";
import { getPost, getPosts } from "@/lib/posts";
import Base from "@/layouts/Base.astro";
import "@/content/styles/article.css";
import { PortableText } from "emdash/ui";

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/404");
const [post, sortedPosts] = await Promise.all([getPost(slug), getPosts()]);
if (!post) return Astro.redirect("/404");

const currentIndex = sortedPosts.findIndex((item) => item.id === post.id);
const newerPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;
const olderPost =
  currentIndex >= 0 && currentIndex < sortedPosts.length - 1
    ? sortedPosts[currentIndex + 1]
    : undefined;
---

<Base
  title={`${post.title} | Vartifact`}
  description={post.description}
  image={post.cover}
  type="article"
  markdown={`/blog/${slug}.md`}
>
  <ArticleClient />
  <Container>
    <article class="post">
      <header class="post-header">
        <p class="eyebrow">Writing <span aria-hidden="true">·</span> <FormattedDate date={post.date} /></p>
        {post.draft && <p class="draft">草稿</p>}
        <h1>{post.title}</h1>
        <p class="byline">
          <span>Michael Tsai</span>
          <span aria-hidden="true">·</span>
          <span>{post.readingTime} 分鐘閱讀</span>
          {post.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>更新於 <FormattedDate date={post.updated} /></span>
            </>
          )}
        </p>
      </header>

      {
        post.cover ? (
          <div class="cover">
            <PostCover
              title={post.title}
              src={post.cover}
              alt={post.coverAlt}
              ratio="16 / 9"
              sizes="(max-width: 26.25rem) calc(100vw - 2rem), (max-width: 45rem) calc(100vw - 2.75rem), 43.5rem"
              priority
            />
          </div>
        ) : (
          <hr class="rule" />
        )
      }

      <div class="content" id="article-content">
        <PortableText value={post.content} />
      </div>

      {(olderPost || newerPost) && (
        <>
          <hr class="rule rule-footer" />
          <nav class="post-pager" aria-label="其他文章">
            {olderPost && (
              <a
                class="pager-link previous"
                href={`/blog/${olderPost.id}`}
                aria-label={`上一篇文章：${olderPost.title}`}
              >
                <span class="pager-eyebrow">← 上一篇</span>
                <span class="pager-title">{olderPost.title}</span>
              </a>
            )}
            {newerPost && (
              <a
                class="pager-link next"
                href={`/blog/${newerPost.id}`}
                aria-label={`下一篇文章：${newerPost.title}`}
              >
                <span class="pager-eyebrow">下一篇 →</span>
                <span class="pager-title">{newerPost.title}</span>
              </a>
            )}
          </nav>
        </>
      )}
    </article>
  </Container>

  <script>
    const progressRoot = document.querySelector<HTMLElement>("[data-article-progress]");
    if (progressRoot) {
      const progress = progressRoot.querySelector<HTMLElement>(".progress");
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - innerHeight;
        const ratio = scrollable > 0 ? Math.min(1, scrollY / scrollable) : 0;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
      };
      updateProgress();
      addEventListener("scroll", updateProgress, { passive: true });
    }

    for (const block of document.querySelectorAll<HTMLElement>("#article-content pre")) {
      if (block.scrollWidth > block.clientWidth) block.tabIndex = 0;
    }
  </script>
</Base>

<style>
  .post { min-width: 0; }
  .post-header { margin-bottom: 2.25rem; }
  .eyebrow,
  .draft,
  .pager-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow { margin-bottom: 1.375rem; color: var(--muted-foreground); }
  .eyebrow span { margin-inline: 0.35rem; color: var(--border); }
  .draft {
    width: fit-content;
    margin-bottom: 0.75rem;
    color: var(--destructive);
  }
  .post-header h1 {
    max-width: 18ch;
    margin-bottom: 1.125rem;
    color: var(--foreground);
    font: 500 clamp(1.875rem, 5.5vw, 2.875rem)/1.1 var(--font-serif);
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    font-style: italic;
    font-variant-numeric: tabular-nums;
  }
  .byline > span[aria-hidden="true"] { color: var(--border); font-style: normal; }
  .cover { margin-bottom: 2.25rem; }
  .rule {
    height: 1px;
    margin: 0 0 2.25rem;
    border: 0;
    background: var(--border);
  }
  .rule-footer { margin: 3.5rem 0 1.75rem; }
  .post-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
    margin-bottom: 1rem;
  }
  .pager-link {
    display: block;
    min-width: 0;
    color: var(--foreground);
    text-decoration: none;
    transition: transform 180ms ease;
  }
  .pager-link.next { text-align: right; }
  .pager-link.previous:hover { transform: translateX(-0.125rem); }
  .pager-link.next:hover { transform: translateX(0.125rem); }
  .pager-eyebrow {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
  }
  .pager-title {
    display: block;
    color: var(--foreground);
    font: 500 1.1rem/1.35 var(--font-serif);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    text-wrap: balance;
    transition: color 180ms ease;
  }
  .pager-link:hover .pager-title { color: var(--primary); }
  .post-pager:has(.pager-link:only-child) .pager-link { grid-column: 1 / -1; }
  @media (width < 45rem) {
    .post-pager { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .pager-link.next { text-align: left; }
  }
</style>

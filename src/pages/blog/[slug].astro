---
import ArticleClient from "@/components/ArticleClient.astro";
import BackToPrev from "@/components/BackToPrev.astro";
import BackToTop from "@/components/BackToTop.astro";
import Container from "@/components/Container.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PostCover from "@/components/PostCover.astro";
import ReactionBar from "@/components/ReactionBar.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Base from "@/layouts/Base.astro";
import { getPost } from "@/lib/posts";
import { getViews } from "@/lib/server/blog";
import { env } from "cloudflare:workers";
import { PortableText } from "emdash/ui";

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/404");
const post = await getPost(slug);
if (!post) return Astro.redirect("/404");
const views = await getViews(env, slug);
const formatStamp = (value?: string) => value?.slice(0, 10).replaceAll("-", ".") ?? "";
---

<Base
  title={`${post.title} | Vartifact`}
  description={post.description}
  image={post.cover}
  type="article"
  markdown={`/blog/${slug}.md`}
>
  <ArticleClient slug={slug} readingTime={post.readingTime} draft={post.draft} />
  <Container>
    <div class="article-layout">
      <TableOfContents />
      <article>
        <div class="article-lede">
          <div class="title-block">
            <h1 class="page-title animate">{post.title}</h1>
            {post.description && <p class="introduction animate">{post.description}</p>}
          </div>
          <div class="article-proof animate">
            <PostCover
              title={post.title}
              src={post.cover}
              alt={post.coverAlt}
              frame="01"
              ratio="16 / 9"
              sizes="(min-width: 92rem) 38rem, (min-width: 48rem) 50vw, calc(100vw - 2rem)"
              priority
            />
            <dl class="article-ledger" aria-label="文章資訊">
              <div>
                <dt>Author</dt>
                <dd>Michael Tsai</dd>
              </div>
              <div>
                <dt>Date</dt>
                <dd><FormattedDate date={post.date} /></dd>
              </div>
              <div>
                <dt>Read time</dt>
                <dd>{post.readingTime} min read</dd>
              </div>
              <div>
                <dt>Views</dt>
                <dd>{views} views</dd>
              </div>
              {post.draft && (
                <div>
                  <dt>Status</dt>
                  <dd class="draft">Draft</dd>
                </div>
              )}
            </dl>
          </div>
        </div>
        <div class="animate content no-drop-cap" id="article-content">
          <PortableText value={post.content} />
        </div>
        <ReactionBar slug={slug} />
        <div class="colophon">
          <span>Filed {formatStamp(post.date)}</span>
          {post.updated && <span>Revised {formatStamp(post.updated)}</span>}
        </div>
      </article>
    </div>
    <div class="back-links animate">
      <BackToPrev />
      <BackToTop />
    </div>
  </Container>
  <script>
    const progressRoot = document.querySelector<HTMLElement>("[data-article-progress]");
    if (progressRoot) {
      const progress = progressRoot.querySelector<HTMLElement>(".progress");
      const slug = progressRoot.dataset.slug ?? "";
      const minSeconds = Number(progressRoot.dataset.minSeconds ?? 10);
      const draft = progressRoot.dataset.draft === "true";
      let counted = false;
      let visibleSeconds = 0;
      let maxScroll = 0;

      const countView = async () => {
        if (draft || counted || visibleSeconds < minSeconds || maxScroll < 0.6) return;
        counted = true;
        try {
          const response = await fetch(`/api/blog/${encodeURIComponent(slug)}/views`, {
            method: "POST",
          });
          if (!response.ok) counted = false;
        } catch {
          counted = false;
        }
      };

      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - innerHeight;
        const ratio = scrollable > 0 ? Math.min(1, scrollY / scrollable) : 0;
        if (progress) progress.style.transform = `scaleX(${ratio})`;
        maxScroll = Math.max(maxScroll, ratio);
        void countView();
      };

      updateProgress();
      addEventListener("scroll", updateProgress, { passive: true });
      if (!draft) {
        setInterval(() => {
          if (!document.hidden) {
            visibleSeconds += 1;
            void countView();
          }
        }, 1000);
      }
    }

    const reactionsRoot = document.querySelector<HTMLElement>("[data-reactions]");
    if (reactionsRoot) {
      const slug = reactionsRoot.dataset.slug ?? "";
      const buttons = Array.from(
        reactionsRoot.querySelectorAll<HTMLButtonElement>("[data-reaction]"),
      );
      let reacted = new Set<string>();
      let reactions: Record<string, number> = {};

      try {
        const stored = JSON.parse(localStorage.getItem(`reactions:${slug}`) ?? "[]");
        if (Array.isArray(stored)) {
          reacted = new Set(stored.filter((value): value is string => typeof value === "string"));
        }
      } catch {}

      const render = (loading = false) => {
        for (const button of buttons) {
          const key = button.dataset.reaction ?? "";
          const label = button.dataset.label ?? "";
          const count = reactions[key] ?? 0;
          const countElement = button.querySelector<HTMLElement>(".count");
          button.disabled = loading;
          button.classList.toggle("loading", loading);
          button.classList.toggle("reacted", reacted.has(key));
          button.setAttribute("aria-label", count ? `${label}，${count} 個` : label);
          if (countElement) {
            countElement.textContent = String(count);
            countElement.hidden = count === 0;
          }
        }
      };

      const loadReactions = async () => {
        render(true);
        try {
          const response = await fetch(`/api/blog/${encodeURIComponent(slug)}/reactions`);
          if (response.ok) reactions = await response.json();
        } finally {
          render(false);
        }
      };

      for (const button of buttons) {
        button.addEventListener("click", async () => {
          const emoji = button.dataset.reaction ?? "";
          const action = reacted.has(emoji) ? "remove" : "add";
          render(true);
          try {
            const response = await fetch(
              `/api/blog/${encodeURIComponent(slug)}/reactions`,
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ emoji, action }),
              },
            );
            if (!response.ok) return;
            reactions = await response.json();
            if (action === "add") reacted.add(emoji);
            else reacted.delete(emoji);
            localStorage.setItem(`reactions:${slug}`, JSON.stringify([...reacted]));
          } catch {
          } finally {
            render(false);
          }
        });
      }

      void loadReactions();
    }
  </script>
</Base>

<style>
  article { min-width: 0; padding-top: 1rem; }
  .article-lede {
    display: grid;
    gap: 2rem;
    padding-block: 1rem 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .draft { color: var(--destructive); }
  .title-block {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding-block: 1rem;
  }
  .title-block > * + * { margin-top: 1.5rem; }
  .page-title {
    color: var(--foreground);
    font: 500 clamp(2.75rem, 4vw, 3.75rem)/1.08 var(--font-serif);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .introduction {
    max-width: 30rem;
    color: var(--muted-foreground);
    font: 1.125rem/1.7 var(--font-serif);
  }
  .article-proof { min-width: 0; }
  .article-ledger {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .article-ledger > div {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.7fr) minmax(0, 1.3fr);
    border-bottom: 1px solid var(--border);
  }
  .article-ledger dt,
  .article-ledger dd { padding: 0.45rem 0.75rem; }
  .article-ledger dt {
    color: var(--muted-foreground);
    border-right: 1px solid var(--border);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .article-ledger dd { margin: 0; letter-spacing: 0.04em; text-transform: uppercase; }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .content { margin-top: 2.5rem; }
  .colophon {
    row-gap: 0.5rem;
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 10px;
  }
  .back-links { display: flex; margin-top: 3rem; }
  @media (width >= 48rem) {
    .introduction { font-size: 1.25rem; }
    .article-lede {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(20rem, 1.1fr);
      align-items: start;
      gap: 2rem;
    }
    .title-block { min-height: 100%; padding-block: 2rem; }
  }
  @media (width >= 48rem) and (width < 64rem) {
    .page-title { font-size: clamp(2.25rem, 5vw, 2.5rem); }
  }
  @media (width >= 64rem) {
    .article-lede {
      grid-template-columns: minmax(20rem, 0.9fr) minmax(26rem, 1.1fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
  @media (width >= 72rem) {
    .article-layout {
      display: grid;
      grid-template-columns: minmax(8rem, 10rem) minmax(0, 1fr);
      gap: clamp(2rem, 3vw, 3rem);
      align-items: start;
    }
    .article-layout > article { grid-column: 2; }
  }
  @media (width < 48rem) {
    .article-lede { gap: 1rem; padding-top: 0.5rem; }
    .title-block { padding-block: 0.5rem; }
    .page-title { font-size: clamp(2.25rem, 10.75vw, 2.75rem); }
    .article-ledger dt,
    .article-ledger dd { padding-inline: 0.5rem; }
  }
</style>

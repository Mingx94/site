---
import { Form } from "@emdash-cms/plugin-forms/ui";
import Base from "@/layouts/Base.astro";
import Container from "@/components/Container.astro";
---

<Base title="聯絡 | Vartifact" description="合作、提問、或打個招呼——請留下訊息。">
  <Container>
    <div class="contact">
      <div class="strip">
        <span>· Correspondence · Contact</span>
        <span>N°03</span>
      </div>

      <div class="title-block">
        <h1 class="page-title">聯絡<span class="accent">.</span></h1>
        <p class="introduction">
          合作、提問、或單純想打個招呼——<br class="desktop-break" />
          請留下訊息，我會回覆。
        </p>
      </div>

      <section class="form-shell" aria-label="聯絡表單">
        <Form id="contact" />
      </section>
    </div>

    <a class="back-link" href="/blog">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 5 12 12 19"></polyline>
      </svg>
      <span>前往文章列表</span>
    </a>
  </Container>
</Base>

<script>
  // Keep EmDash's submission and validation flow; supplement its field metadata.
  for (const form of document.querySelectorAll<HTMLFormElement>(".form-shell [data-ec-form]")) {
    for (const [index, field] of Array.from(form.querySelectorAll<HTMLElement>(".ec-form-field")).entries()) {
      const controls = Array.from(field.querySelectorAll<HTMLElement>(
        'input:not([type="hidden"]), textarea, select',
      ));
      if (controls.length === 0 || field.closest('[aria-hidden="true"]')) continue;
      const help = field.querySelector<HTMLElement>(".ec-form-help");
      const error = field.querySelector<HTMLElement>("[data-error-for]");
      const prefix = `${form.dataset.formId}-field-${index}`;
      if (help) help.id ||= `${prefix}-help`;
      if (error) error.id ||= `${prefix}-error`;

      for (const control of controls) {
        const descriptions = new Set((control.getAttribute("aria-describedby") ?? "").split(/\s+/).filter(Boolean));
        if (help) descriptions.add(help.id);
        if (error) descriptions.add(error.id);
        if (descriptions.size) control.setAttribute("aria-describedby", [...descriptions].join(" "));
        if (control instanceof HTMLInputElement && !control.hasAttribute("autocomplete")) {
          if (control.type === "email") control.autocomplete = "email";
          else if (control.type === "tel") control.autocomplete = "tel";
          else if (control.type === "text" && control.name === "name") control.autocomplete = "name";
        }
      }

      if (error) {
        const syncError = () => {
          for (const control of controls) {
            if (error.textContent?.trim()) control.setAttribute("aria-invalid", "true");
            else control.removeAttribute("aria-invalid");
          }
        };
        syncError();
        // EmDash writes server errors here and clears them when the user edits.
        new MutationObserver(syncError).observe(error, { childList: true, characterData: true, subtree: true });
        form.addEventListener("reset", () => { error.textContent = ""; });
      }
    }
  }
</script>

<style is:global>
  @import "@emdash-cms/plugin-forms/styles";
</style>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-block: 1rem 2rem;
  }
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font: 0.6875rem var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .title-block {
    margin-top: -1.5rem;
  }
  .title-block > * + * {
    margin-top: 1.5rem;
  }
  .page-title {
    color: var(--foreground);
    font-size: clamp(3rem, 10vw, 6rem);
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .accent {
    color: var(--primary);
  }
  .introduction {
    max-width: 42rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.625;
    font-family: var(--font-serif);
  }
  .desktop-break {
    display: none;
  }
  .form-shell {
    min-width: 0;
  }
  .form-shell :global(.ec-form) {
    --ec-form-gap: 1.5rem;
    --ec-form-field-border: 0;
    --ec-form-field-radius: 0;
    --ec-form-field-padding: 0.5rem 0;
    --ec-form-field-bg: transparent;
    --ec-form-error-color: var(--destructive);
    --ec-form-required-color: var(--primary);
    --ec-form-help-color: var(--muted-foreground);
    --ec-form-submit-bg: var(--primary);
    --ec-form-submit-color: var(--primary-foreground);
    --ec-form-submit-radius: var(--radius);

    width: 100%;
    max-width: 40rem;
  }
  .form-shell :global(.ec-form-field) {
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .form-shell :global(.ec-form-label) {
    color: var(--muted-foreground);
    font: 0.625rem var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .form-shell :global(.ec-form-input) {
    min-height: 2.75rem;
    color: var(--foreground);
    border-bottom: 1px solid var(--border);
    box-shadow: none;
    font-size: 1.125rem;
    font-family: var(--font-serif);
    appearance: none;
  }
  .form-shell :global(.ec-form-input:focus) {
    border-bottom: 2px solid var(--primary);
    outline: none;
  }
  .form-shell :global(textarea.ec-form-input) {
    font-size: 1rem;
  }
  .form-shell :global(.ec-form-nav) {
    justify-content: flex-end;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .form-shell :global(.ec-form-submit),
  .form-shell :global(.ec-form-next),
  .form-shell :global(.ec-form-prev) {
    min-height: 2.5rem;
  }
  .form-shell :global(.ec-form-status) {
    border-radius: 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    min-height: 2.5rem;
    margin-top: 2rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--foreground);
    font-size: 0.875rem;
  }
  .back-link:hover {
    background: var(--accent);
  }
  .back-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  @media (width >= 48rem) {
    .contact {
      gap: 4rem;
      padding-top: 2rem;
    }
    .title-block {
      margin-top: -2.5rem;
    }
    .introduction {
      font-size: 1.25rem;
    }
    .desktop-break {
      display: inline;
    }
  }
  @media (width >= 64rem) {
    .contact {
      display: grid;
      grid-template-areas:
        "strip strip"
        "title form";
      grid-template-columns: minmax(16rem, 0.8fr) minmax(28rem, 1fr);
      column-gap: clamp(4rem, 8vw, 9rem);
      row-gap: 4rem;
    }
    .strip {
      grid-area: strip;
    }
    .title-block {
      grid-area: title;
      min-width: 0;
      margin-top: 0;
    }
    .form-shell {
      grid-area: form;
    }
  }
</style>

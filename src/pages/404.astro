---
import Container from "@/components/Container.astro";
import Link from "@/components/Link.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="404 | Vartifact" noindex>
  <Container>
    <div class="error animate">
      <h1>404</h1>
      <p>找不到這個頁面，它可能已被移動或刪除。</p>
      <div class="links">
        <Link href="/">回到首頁</Link>
        <Link href="/blog">瀏覽文章</Link>
      </div>
    </div>
  </Container>
</Base>

<style>
  .error {
    margin-block: 5rem;
  }
  .error > * + * {
    margin-top: 1rem;
  }
  h1 {
    color: var(--foreground);
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  p {
    color: var(--muted-foreground);
  }
  .links {
    display: flex;
    gap: 0.75rem;
  }
</style>

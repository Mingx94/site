---
import Base from "@/layouts/Base.astro";
Astro.response.status = 404;
---
<Base title="404 — 找不到頁面 | Vartifact" description="找不到你要瀏覽的頁面。" noindex>
  <section class="not-found">
    <div class="eyebrow">錯誤 · 404</div>
    <h1>這個頁面走丟了。</h1>
    <p>你要瀏覽的頁面不存在，可能已被移動或刪除。請回到<a href="/">首頁</a>，或瀏覽<a href="/blog">文章</a>。</p>
  </section>
</Base>
<style>
	.not-found { padding: 24px 0 80px; max-width: 56ch; }
	.eyebrow {
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: hsl(var(--theme-text-muted));
		margin-bottom: 24px;
	}
	.not-found h1 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
		line-height: 1.12;
		color: hsl(var(--theme-text));
		margin: 0 0 18px;
	}
	.not-found p {
		font-size: 17.5px;
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.not-found a {
		color: hsl(var(--theme-accent));
		border-bottom: 1px solid hsl(var(--theme-accent) / 0.4);
		padding-bottom: 1px;
		transition: border-color 0.2s ease;
	}
	.not-found a:hover { border-color: hsl(var(--theme-accent)); }
</style>

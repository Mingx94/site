---
import Base from "@/layouts/Base.astro";
import config from "@/config";
export const prerender = true;
const socials = [{ name: "GitHub", href: config.social.github }, { name: "LinkedIn", href: config.social.linkedin }, { name: "X", href: config.social.twitter }, { name: "Bluesky", href: config.social.bluesky }].filter(item => item.href);
---
<Base title="關於 | Vartifact" description="關於 Michael Tsai — 前端工程師，Vartifact 部落格的作者。">
  <section class="about" aria-labelledby="about-label">
    <h1 class="section-label" id="about-label">關於</h1>
    <div class="bio">
      <p>我是 Michael Tsai。前端工程師，在台灣工作。關注效能、無障礙設計與產品細節，也用攝影和閱讀觀察世界。</p>
      <p>工作上主要使用 React 與 Next.js 開發 Web 應用。這個部落格則用 Astro 與 EmDash 打造，邊探索邊實作，把新框架當作思考與整理的素材。</p>
      <p>出門時常帶著相機。部落格裡的圖片大多是自己拍的。拍攝和寫程式有點像，都在尋找更精簡、更有力量的表達。</p>
      <p>你也可以在{socials.map((item, i) => <>{i > 0 && "、"}<a href={item.href} rel="noreferrer" target="_blank">{item.name}</a></>)}找到我。</p>
    </div>
  </section>
</Base>
<style>
	.about {
		margin-bottom: 64px;
	}
	.bio {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.75;
		color: hsl(var(--theme-text));
		max-width: var(--reading-width);
	}
	.bio :global(ul) {
		list-style: disc;
		list-style-position: inside;
		margin: 0 0 28px;
		padding: 0;
	}
	.bio :global(ul li) {
		margin-bottom: 6px;
		text-wrap: pretty;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.bio :global(ul li:last-child) {
		margin-bottom: 0;
	}
	.bio :global(p) {
		margin: 0 0 22px;
		text-wrap: pretty;
	}
	.bio :global(p:last-child) {
		margin-bottom: 0;
	}
	.bio :global(a) {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.bio :global(a:hover) {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.bio :global(a:focus-visible) {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.bio {
			font-size: 17px;
			line-height: 1.7;
		}
	}
	@media (max-width: 420px) {
		.bio {
			font-size: 16.5px;
		}
	}
</style>

---
import { getPosts, getTags } from "@/lib/posts";
import PostList from "@/components/blog/PostList.astro";
import Base from "@/layouts/Base.astro";
const allPosts = await getPosts();
const tag = getTags(allPosts).find(item => item.slug === Astro.params.tag);
if (!tag) return Astro.rewrite("/404");
const posts = allPosts.filter(post => post.tags.some(item => item.slug === tag.slug));
---
<Base title={`#${tag.name} | Vartifact`} description={`標籤「${tag.name}」的所有文章。`}>
  <section class="tag-archive" aria-labelledby="tag-label">
    <nav class="crumbs" aria-label="導覽路徑"><a data-astro-prefetch href="/tags">標籤</a><span class="sep" aria-hidden="true">/</span><span class="current" aria-current="page">#{tag.name}</span></nav>
    <h1 class="section-label" id="tag-label">#{tag.name} · {posts.length} 篇文章</h1>
    <div class="timeline"><PostList posts={posts} /></div>
  </section>
</Base>
<style>
	.tag-archive {
		margin-bottom: 96px;
	}

	.crumbs {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		color: hsl(var(--theme-text) / 0.55);
		margin-bottom: 18px;
	}
	.crumbs a {
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.crumbs a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.crumbs a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}
	.crumbs .sep {
		color: var(--faint);
		margin: 0 8px;
	}

	@media (max-width: 420px) {
		.tag-archive {
			margin-bottom: 64px;
		}
	}
</style>

---
import PostList from "@/components/blog/PostList.astro";
import { getPosts } from "@/lib/posts";
import { showcase } from "@/data/showcase";
import Base from "@/layouts/Base.astro";
import config from "@/config";
import { formatRailDate, formatStampDate } from "@/lib/date";
const allPosts = await getPosts();
const [featured, ...rest] = allPosts.slice(0, config.settings.num_posts_on_homepage);
const socials = [{ name: "GitHub", href: config.social.github }, { name: "LinkedIn", href: config.social.linkedin }, { name: "X", href: config.social.twitter }, { name: "Bluesky", href: config.social.bluesky }].filter(item => item.href);
---
<Base>
  <h1 class="visually-hidden">{config.site.name} — {config.metadata.meta_description}</h1>
  <section class="hero">
    <p>前端工程師的個人書寫空間。記錄程式、設計、閱讀，以及日常裡值得留下的片段。</p>
    <div class="socials">
      {socials.map(item => <><a href={item.href} rel="noreferrer" target="_blank">{item.name}</a><span class="sep" aria-hidden="true">·</span></>)}
      <a href="/rss.xml">RSS</a>
    </div>
  </section>
  <section class="writing" aria-labelledby="writing-label">
    <h2 class="section-label" id="writing-label">文章</h2>
    {featured ? <div class="timeline">
      <div class="post featured" style="--i: 0">
        <div class="post-rail"><time class="post-date" datetime={featured.date}>{formatRailDate(featured.date)}</time><span class="post-dot" aria-hidden="true" /></div>
        <div class="post-body">
          <div class="post-stamp">最新文章 · {formatStampDate(featured.date)}</div>
          <h3 class="post-title"><a class="post-cardlink" data-astro-prefetch href={`/blog/${encodeURIComponent(featured.id)}`}>{featured.title}</a></h3>
          {featured.description && <p class="post-excerpt">{featured.description}</p>}
          {!!featured.tags.length && <div class="post-meta">{featured.tags.map((tag, i) => <>{i > 0 && <span class="dot">·</span>}<a class="tag" data-astro-prefetch href={`/tags/${encodeURIComponent(tag.slug)}`}>{tag.name}</a></>)}</div>}
        </div>
      </div>
      <PostList posts={rest} startIndex={1} headingLevel="h3" />
      <div class="archive-link" style={`--i: ${rest.length + 1}`}><a data-astro-prefetch href="/blog">查看全部 {allPosts.length} 篇文章 →</a></div>
    </div> : <div class="empty-state"><p>目前沒有公開文章。</p><a data-astro-prefetch href="/about">關於 Michael →</a></div>}
  </section>
  {showcase.length > 0 && <section class="work" aria-labelledby="work-label">
    <h2 class="section-label" id="work-label">作品</h2>
    <ul class="work-list">{showcase.map((item, idx) => <li style={`--i: ${idx + 1}`}><a href={item.href} rel="noreferrer" target="_blank"><div class="head"><span class="name">{item.name}</span><span class="stack">{item.stack}</span>{item.badge && <span class="badge">{item.badge}</span>}</div><p>{item.desc}</p></a></li>)}</ul>
  </section>}
</Base>
<style>
	/* ---------- Hero ---------- */
	.hero {
		margin-bottom: 76px;
	}
	.hero p {
		font-size: 19.5px;
		line-height: 1.65;
		color: hsl(var(--theme-text));
		margin: 0 0 22px;
		max-width: 60ch;
		text-wrap: pretty;
		white-space: pre-line;
	}
	.socials {
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
		margin-top: 18px;
	}
	.socials a {
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.socials a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.socials .sep {
		color: var(--faint);
		margin: 0 9px;
	}

	/* ---------- Writing timeline ---------- */
	.writing {
		margin-bottom: 84px;
	}
	/* ---------- Featured post ---------- */
	.post.featured .post-body {
		position: relative;
		padding-bottom: 56px;
	}
	/* Title is the post link; its ::after stretches over the whole card body so
	   clicking anywhere opens the post, while the tag links sit above it. */
	.post.featured .post-cardlink {
		color: inherit;
		text-decoration: none;
	}
	.post.featured .post-cardlink::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
	}
	.post.featured .post-cardlink:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}
	.post.featured .post-stamp {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: hsl(var(--theme-accent));
		margin-bottom: 12px;
	}
	.post.featured .post-title {
		font-size: 30px;
		line-height: 1.14;
		margin-bottom: 14px;
		letter-spacing: -0.02em;
	}
	.post.featured .post-excerpt {
		font-size: 18px;
		line-height: 1.62;
		color: hsl(var(--theme-text-muted));
		margin: 0 0 14px;
		max-width: 58ch;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.post.featured .post-meta {
		position: relative;
		z-index: 2;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: hsl(var(--theme-text) / 0.55);
		font-variant-numeric: tabular-nums;
		font-feature-settings: "tnum";
	}
	.post.featured .post-meta .tag {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.post.featured .post-meta .tag::before {
		content: "#";
		color: var(--faint);
		transition: color 0.2s ease;
	}
	.post.featured .post-meta .tag:hover,
	.post.featured .post-meta .tag:hover::before {
		color: hsl(var(--theme-accent));
	}
	.post.featured .post-meta .tag:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 2px;
		border-radius: 3px;
	}
	.post.featured .post-meta .dot {
		color: var(--faint);
		margin: 0 8px;
	}
	.post.featured .post-dot {
		--rail-dot-size: 11px;
		border-color: hsl(var(--theme-text-muted));
	}
	.post.featured:hover .post-dot {
		background: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent));
	}

	.archive-link {
		grid-column: 2;
		margin-top: 8px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
	}
	.archive-link a {
		display: inline-block;
		padding: 6px 0;
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.archive-link a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}

	.work {
		margin-bottom: 88px;
	}

	.socials a:focus-visible,
	.archive-link a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.hero {
			margin-bottom: 56px;
		}
		.hero p {
			font-size: 18px;
		}
		.post.featured .post-rail {
			display: none;
		}
		.post.featured .post-body {
			padding-bottom: 24px;
			border-bottom: 1px solid var(--hairline);
			margin-bottom: 4px;
		}
		.post.featured .post-title {
			font-size: 22px;
			line-height: 1.2;
			letter-spacing: -0.015em;
			margin-bottom: 10px;
		}
		.post.featured .post-excerpt {
			font-size: 15.5px;
			line-height: 1.55;
			margin: 0 0 10px;
		}
		.post.featured .post-meta {
			font-size: 11px;
		}
		.archive-link {
			margin-top: 0;
		}
	}

	@media (max-width: 420px) {
		.hero {
			margin-bottom: 48px;
		}
		.hero p {
			font-size: 17px;
		}
		.socials {
			font-size: 12.5px;
		}
		.socials .sep {
			margin: 0 6px;
		}
		.writing {
			margin-bottom: 64px;
		}
		.post.featured .post-title {
			font-size: 17px;
		}
		.post.featured .post-excerpt {
			font-size: 15px;
		}
		.work {
			margin-bottom: 56px;
		}
	}
</style>

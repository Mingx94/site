---
import BackToTop from "@/components/BackToTop.astro";
import Container from "@/components/Container.astro";
import Link from "@/components/Link.astro";
import config from "@/config";
import { getPosts } from "@/lib/posts";
import Base from "@/layouts/Base.astro";

const posts = await getPosts();
const recentBlogs = posts.slice(0, config.settings.num_posts_on_homepage);
const elsewhere = [
  { label: "GitHub", href: config.social.github },
  { label: "LinkedIn", href: config.social.linkedin },
  { label: "X", href: config.social.twitter },
].filter((item) => item.href);
const formatRailDate = (value: string) =>
  new Intl.DateTimeFormat("zh-TW", { month: "numeric", day: "numeric" }).format(new Date(value));
---

<Base>
  <Container>
    <div class="home">
      <section class="hero" aria-labelledby="home-title">
        <p class="eyebrow">Michael Tsai · Taiwan</p>
        <h1 id="home-title">分享技術及生活<span aria-hidden="true">。</span></h1>
        <p class="introduction">
          前端工程師的個人書寫空間。記錄程式、設計、閱讀，以及日常裡值得留下的片段。
        </p>
        {
          elsewhere.length > 0 && (
            <ul class="socials" role="list" aria-label="其他平台">
              {elsewhere.map((item) => (
                <li><Link href={item.href} external>{item.label}</Link></li>
              ))}
              <li><Link href="/rss.xml" external aria-label="RSS 訂閱">RSS</Link></li>
            </ul>
          )
        }
      </section>

      {
        recentBlogs.length > 0 ? (
          <section class="writing" aria-labelledby="writing-title">
            <h2 class="section-label" id="writing-title">Writing</h2>
            <ol class="timeline" role="list">
              {recentBlogs.map((post, index) => (
                <li class:list={["post", { featured: index === 0 }]}>
                  <div class="post-rail">
                    <time datetime={new Date(post.date).toISOString()}>{formatRailDate(post.date)}</time>
                    <span class="post-dot" aria-hidden="true"></span>
                  </div>
                  <div class="post-body">
                    {index === 0 && <p class="post-stamp">Latest</p>}
                    <h3><a href={`/blog/${post.id}`}>{post.title}</a></h3>
                    {post.description && <p class="post-description">{post.description}</p>}
                    <p class="post-meta">{post.readingTime} 分鐘閱讀</p>
                  </div>
                </li>
              ))}
            </ol>
            {posts.length > recentBlogs.length && (
              <p class="archive-link">
                <Link href="/blog">查看全部 {posts.length} 篇文章 →</Link>
              </p>
            )}
          </section>
        ) : (
          <section class="empty-writing" aria-labelledby="empty-title">
            <p class="eyebrow">Writing</p>
            <h2 id="empty-title">目前沒有公開文章</h2>
            <p>新的文章會出現在這裡。你也可以先認識作者。</p>
            <Link href="/about">關於 Michael →</Link>
          </section>
        )
      }
    </div>
    <div class="back-top"><BackToTop /></div>
  </Container>
</Base>

<style>
  .home { padding-block: 0 1rem; }
  .hero { margin-bottom: clamp(4.5rem, 10vw, 7rem); }
  .eyebrow,
  .section-label,
  .post-stamp,
  .post-meta {
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 14ch;
    margin-top: 1rem;
    color: var(--foreground);
    font: 500 clamp(2.25rem, 8vw, 3.75rem)/1.1 var(--font-serif);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero h1 span { color: var(--primary); }
  .introduction {
    max-width: 35rem;
    margin-top: 1.25rem;
    color: var(--muted-foreground);
    font-size: clamp(1.0625rem, 2.5vw, 1.1875rem);
    line-height: 1.75;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .socials :global(a) {
    color: var(--muted-foreground);
    text-decoration-color: color-mix(in srgb, var(--muted-foreground) 45%, transparent);
  }
  .socials :global(a:hover) { color: var(--primary); }
  .section-label { margin-bottom: 2rem; }
  .timeline {
    --rail-width: 6.5rem;
    --rail-gap: 2rem;
    position: relative;
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
  }
  .timeline::before {
    position: absolute;
    top: 0.45rem;
    bottom: 0.45rem;
    left: calc(var(--rail-width) - 1px);
    width: 1px;
    background: var(--border);
    content: "";
  }
  .post {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    column-gap: var(--rail-gap);
  }
  .post-rail {
    position: relative;
    padding-top: 0.2rem;
    padding-right: 1.25rem;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .post-dot {
    position: absolute;
    z-index: 1;
    top: 0.6rem;
    right: -0.3rem;
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid var(--border);
    border-radius: 50%;
    background: var(--background);
    transition: border-color 180ms ease, background-color 180ms ease;
  }
  .post-body { padding-bottom: 2.5rem; }
  .post-stamp { margin-bottom: 0.5rem; color: var(--primary); font-size: 0.6875rem; }
  .post h3 {
    color: var(--foreground);
    font: 500 1.25rem/1.35 var(--font-serif);
    letter-spacing: -0.018em;
    text-wrap: balance;
  }
  .post.featured h3 { font-size: clamp(1.6rem, 4vw, 2rem); }
  .post h3 a { text-decoration: none; }
  .post h3 a:hover { color: var(--primary); }
  .post:has(h3 a:hover) .post-dot {
    border-color: var(--primary);
    background: var(--primary);
  }
  .post-description {
    max-width: 36rem;
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.975rem;
    line-height: 1.65;
  }
  .post.featured .post-description { font-size: 1.0625rem; }
  .post-meta { margin-top: 0.65rem; font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: none; }
  .archive-link {
    margin-top: 0.25rem;
    margin-left: calc(var(--rail-width) + var(--rail-gap));
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .archive-link :global(a) { color: var(--muted-foreground); }
  .archive-link :global(a:hover) { color: var(--primary); }
  .empty-writing {
    padding-block: 2rem;
    border-block: 1px solid var(--border);
  }
  .empty-writing h2 {
    margin-block: 0.75rem;
    font: 500 clamp(1.75rem, 5vw, 2.5rem)/1.2 var(--font-serif);
  }
  .empty-writing p:not(.eyebrow) { margin-bottom: 1rem; color: var(--muted-foreground); }
  .back-top { display: flex; margin-top: 3rem; }
  @media (width < 34rem) {
    .timeline { --rail-width: 4.75rem; --rail-gap: 1.15rem; }
    .post-rail { padding-right: 0.8rem; font-size: 0.6875rem; }
    .post-body { padding-bottom: 2rem; }
    .post h3 { font-size: 1.125rem; }
    .post.featured h3 { font-size: 1.45rem; }
    .post-description { font-size: 0.9375rem; }
  }
</style>

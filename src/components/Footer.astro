---
import config from "@/config";
import Container from "./Container.astro";
import Link from "./Link.astro";
import ThemeSettings from "./ThemeSettings.astro";
---

<footer class="animate">
  <Container>
    <div class="footer-inner">
      <div class="primary-row">
        <span class="copyright">{config.params.copyright}</span>
        <nav class="links" aria-label="頁尾導覽">
          <Link href="/blog" underline={false} class="footer-link">Writing</Link>
          <Link href="/rss.xml" external underline={false} class="footer-link" aria-label="RSS 訂閱">RSS</Link>
          <Link href="/about" underline={false} class="footer-link">About</Link>
        </nav>
      </div>
      <ThemeSettings />
    </div>
  </Container>
</footer>

<style>
  footer { padding-bottom: 2rem; }
  .footer-inner {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .primary-row,
  .links { display: flex; flex-wrap: wrap; }
  .primary-row { align-items: baseline; justify-content: space-between; gap: 0.75rem 1.5rem; }
  .links { align-items: baseline; gap: 1.25rem; font: 500 0.75rem var(--font-sans); }
  :global(.footer-link) { color: var(--muted-foreground) !important; }
  :global(.footer-link:hover) { color: var(--primary) !important; }
  .copyright { color: var(--muted-foreground); font-size: 0.75rem; }
  :global(.theme-settings) { justify-self: start; }
  @media (width < 48rem), (pointer: coarse) {
    :global(.footer-link) { display: inline-flex !important; min-width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center; }
  }
</style>

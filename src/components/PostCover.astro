---
import { imageConfig } from "astro:assets";
import { COVER_WIDTHS, coverDeliveryUrl } from "@/lib/coverVariants";

interface Props {
  title: string;
  contentId?: string;
  src?: string;
  alt?: string;
  mediaId?: string;
  storageKey?: string;
  ratio?: string;
  sizes?: string;
  priority?: boolean;
}

const {
  title,
  contentId,
  src,
  alt,
  mediaId,
  storageKey,
  ratio = "16 / 9",
  sizes = "100vw",
  priority = false,
} = Astro.props;

const imageSrc = src ? new URL(src, Astro.site ?? Astro.url).href : undefined;
const imageAlt = alt ?? (title.trim() || "文章封面");
const fallbackSrc = (width: number) => {
  const params = new URLSearchParams({ href: imageSrc!, w: String(width), f: "webp" });
  return `${imageConfig.endpoint.route}?${params}`;
};
const responsiveSrc = (width: number) =>
  contentId && mediaId && storageKey
    ? coverDeliveryUrl(contentId, mediaId, width)
    : fallbackSrc(width);
---

<figure class="post-cover" style={`--cover-ratio:${ratio}`}>
  {
    imageSrc ? (
      <img
        src={responsiveSrc(1280)}
        srcset={COVER_WIDTHS.map((width) => `${responsiveSrc(width)} ${width}w`).join(", ")}
        sizes={sizes}
        alt={imageAlt}
        width="1280"
        height="720"
        fetchpriority={priority ? "high" : undefined}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
      />
    ) : (
      <div class="missing-image" role="img" aria-label={`${title}：封面圖片暫時無法顯示`}>
        <span aria-hidden="true">Vartifact</span>
        <strong aria-hidden="true">{title}</strong>
      </div>
    )
  }
</figure>

<style>
  .post-cover {
    position: relative;
    aspect-ratio: var(--cover-ratio);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
  }
  img,
  .missing-image {
    width: 100%;
    height: 100%;
  }
  img { object-fit: cover; }
  .missing-image {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: clamp(1.25rem, 5vw, 2.5rem);
    color: var(--muted-foreground);
    background:
      linear-gradient(145deg, transparent 30%, color-mix(in srgb, var(--primary) 8%, transparent)),
      var(--card);
  }
  .missing-image span {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .missing-image strong {
    display: -webkit-box;
    overflow: hidden;
    color: var(--foreground);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
</style>

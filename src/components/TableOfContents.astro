<section class="article-toc" data-table-of-contents hidden>
  <h2>Table of contents</h2>
  <details>
    <summary>Open Table of contents</summary>
    <nav aria-label="文章目錄">
      <ul class="toc-list" data-toc-list></ul>
    </nav>
  </details>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-table-of-contents]");
  const content = document.querySelector<HTMLElement>("#article-content");

  if (root && content) {
    const headings = Array.from(content.querySelectorAll<HTMLElement>("h2, h3"));
    const list = root.querySelector<HTMLUListElement>("[data-toc-list]");

    if (headings.length > 0 && list) {
      const usedIds = new Set(
        Array.from(document.querySelectorAll<HTMLElement>("[id]"))
          .map((element) => element.id)
          .filter(Boolean),
      );

      const createId = (text: string, index: number) => {
        const base =
          text
            .normalize("NFKC")
            .toLocaleLowerCase()
            .replace(/[^\p{Letter}\p{Number}]+/gu, "-")
            .replace(/^-|-$/g, "") || `section-${index + 1}`;
        let id = base;
        let suffix = 2;
        while (usedIds.has(id)) id = `${base}-${suffix++}`;
        usedIds.add(id);
        return id;
      };

      let subsectionList: HTMLUListElement | null = null;

      headings.forEach((heading, index) => {
        const text = heading.textContent?.trim() ?? "";
        heading.id ||= createId(text, index);

        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `#${heading.id}`;
        link.textContent = text;
        item.appendChild(link);

        if (heading.tagName === "H2") {
          list.appendChild(item);
          subsectionList = document.createElement("ul");
          item.appendChild(subsectionList);
        } else if (subsectionList) {
          subsectionList.appendChild(item);
        } else {
          item.classList.add("subsection");
          list.appendChild(item);
        }
      });

      for (const emptyList of list.querySelectorAll("ul:empty")) emptyList.remove();
      root.hidden = false;
    }
  }
</script>

<style>
  [hidden] { display: none !important; }
  .article-toc {
    margin-top: 2.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--border);
  }
  .article-toc h2 {
    margin: 0 0 1rem;
    color: var(--foreground);
    font: 600 1.5rem/1.25 var(--font-serif);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  details { color: var(--foreground); }
  summary {
    inline-size: fit-content;
    color: var(--primary);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }
  summary:hover { color: var(--accent-foreground); }
  .toc-list,
  .toc-list :global(ul) {
    margin-block: 1rem 0;
    padding-inline-start: 1.5rem;
  }
  .toc-list {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .toc-list :global(ul) { margin-block-start: 0.25rem; }
  .toc-list :global(li + li) { margin-top: 0.25rem; }
  .toc-list :global(li::marker) { color: var(--primary); }
  .toc-list :global(a) {
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition:
      color 200ms,
      text-decoration-color 200ms;
  }
  .toc-list :global(a:hover) {
    color: var(--foreground);
    text-decoration-color: currentColor;
  }
  .toc-list :global(.subsection) { margin-inline-start: 1rem; }
  @media (width >= 48rem) {
    .article-toc h2 { font-size: 1.875rem; }
  }
</style>

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="切換為深色主題"
  title="切換為深色主題"
>
  <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 16 16" fill="none">
    <path d="M13.4 10.2A5.7 5.7 0 0 1 5.8 2.6 5.7 5.7 0 1 0 13.4 10.2Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 16 16" fill="none">
    <circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1.4"></circle>
    <path d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M12.6 3.4l-.9.9M4.3 11.7l-.9.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
  </svg>
  <span data-theme-label>深色</span>
  <span class="visually-hidden" data-theme-status aria-live="polite">目前使用系統主題</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    min-block-size: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.375rem 0.75rem;
    background: var(--accent-soft);
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .theme-toggle:hover {
    background: var(--accent-soft-strong);
    color: var(--primary);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
  .theme-icon {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    flex: none;
    margin-inline-end: 0.375rem;
  }
  .theme-icon-sun { display: none; }
  :global(html.dark) .theme-icon-moon { display: none; }
  :global(html.dark) .theme-icon-sun { display: block; }
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (width < 48rem), (pointer: coarse) {
    .theme-toggle { min-block-size: 2.75rem; }
  }
</style>

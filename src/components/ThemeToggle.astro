<button class="theme-toggle" id="theme-toggle" data-theme-toggle type="button" aria-label="切換主題">
	<span class="icon" aria-hidden="true"></span>
	<span class="label"></span>
</button>

<style is:global>
	.theme-toggle {
		display: inline-block;
		padding: 6px 12px;
		border-radius: 999px;
		background: var(--accent-soft);
		color: hsl(var(--theme-text-muted));
		border: 1px solid transparent;
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 500;
		line-height: 1.4;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.theme-toggle:hover {
		background: var(--accent-soft-strong);
		color: hsl(var(--theme-accent));
	}
	.theme-toggle:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
	}

	.theme-toggle .icon {
		display: inline-block;
		width: 1em;
		font-size: 13px;
		margin-right: 6px;
		text-align: center;
		transform: translateY(-1px);
	}
	.theme-toggle .icon::before { content: "☾"; }
	[data-theme="dark"] .theme-toggle .icon::before { content: "☀"; }

	.theme-toggle .label {
		display: inline-block;
		min-width: 2.6em;
		text-align: left;
	}
	.theme-toggle .label::before { content: "深色"; }
	[data-theme="dark"] .theme-toggle .label::before { content: "淺色"; }
</style>

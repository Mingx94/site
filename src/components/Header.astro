---
import Container from "./Container.astro";
import FontToggle from "./FontToggle.astro";
import Link from "./Link.astro";
import Logo from "./Logo.astro";

const { pathname } = Astro.props;
const navItems = [
  { href: "/blog", label: "Writing" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header>
  <Container>
    <div class="bar">
      <Link href="/" underline={false} title="首頁" class="home-link"><Logo /></Link>
      <nav aria-label="主要導覽">
        {
          navItems.map((item) => (
            <Link
              href={item.href}
              underline={false}
              class:list={["nav-link", { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
              {isActive(item.href) && <span class="active-line" aria-hidden="true"></span>}
            </Link>
          ))
        }
        <span class="divider" aria-hidden="true"></span>
        <FontToggle />
      </nav>
    </div>
  </Container>
</header>

<style>
  .bar,
  nav {
    display: flex;
    align-items: baseline;
  }
  .bar {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }
  nav { flex-wrap: wrap; gap: clamp(0.1rem, 1vw, 1.25rem); }
  :global(.home-link) { color: var(--foreground) !important; }
  :global(.home-link:hover) { color: var(--primary) !important; }
  :global(.nav-link) {
    position: relative;
    padding: 0.35rem 0.25rem;
    color: var(--muted-foreground) !important;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: color 180ms ease;
  }
  :global(.nav-link:hover),
  :global(.nav-link.active) { color: var(--foreground) !important; }
  .active-line {
    position: absolute;
    right: 0.25rem;
    bottom: 0;
    left: 0.25rem;
    height: 1px;
    background: var(--primary);
  }
  .divider { width: 1px; height: 0.75rem; margin-inline: 0.25rem; background: var(--border); }
  @media (width < 48rem), (pointer: coarse) {
    :global(.home-link), :global(.nav-link) { display: inline-flex !important; min-width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center; }
    :global(.font-toggle .toggle) { min-height: 2.75rem; }
  }
  @media (width < 30rem) {
    .bar { gap: 0.5rem; }
    nav { gap: 0; }
    :global(.nav-link) { padding-inline: 0.25rem; font-size: 0.875rem; }
    .divider { margin-inline: 0.1rem; }
    :global(.font-toggle .toggle) { padding-inline: 0.25rem; }
  }
  @media (width < 23rem) {
    .bar { flex-direction: column; align-items: stretch; }
    nav { width: 100%; justify-content: space-between; }
  }
</style>

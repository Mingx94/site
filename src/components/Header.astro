---
import Container from "./Container.astro";
import FontToggle from "./FontToggle.astro";
import Link from "./Link.astro";
import Logo from "./Logo.astro";
import ThemeSettings from "./ThemeSettings.astro";

const { pathname } = Astro.props;
const navItems = [
  { href: "/", label: "Home", icon: "M2.5 6.5 8 2l5.5 4.5V13a1 1 0 0 1-1 1H10v-4H6v4H3.5a1 1 0 0 1-1-1Z" },
  { href: "/blog", label: "Writing", icon: "M3 2.5h7l3 3V13a.5.5 0 0 1-.5.5h-9.5A.5.5 0 0 1 2.5 13V3a.5.5 0 0 1 .5-.5Z M10 2.5v3h3 M5.5 8.5h5 M5.5 11H9" },
  { href: "/about", label: "About", icon: "M8 8.5A2.5 2.5 0 1 0 8 3a2.5 2.5 0 0 0 0 5.5ZM3 13c.6-2.4 2.6-3.5 5-3.5s4.4 1.1 5 3.5" },
];
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header>
  <Container>
    <div class="bar">
      <Link href="/" underline={false} title="首頁" class="home-link"><Logo /></Link>
      <div class="header-right">
        <nav aria-label="主要導覽">
          {
            navItems.map((item) => (
              <Link
                href={item.href}
                underline={false}
                class:list={["nav-link", { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                <svg class="nav-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={item.icon}></path>
                </svg>
                <span>{item.label}</span>
                {isActive(item.href) && <span class="active-line" aria-hidden="true"></span>}
              </Link>
            ))
          }
        </nav>
        <div class="controls" role="group" aria-label="顯示設定">
          <FontToggle />
          <ThemeSettings />
        </div>
      </div>
    </div>
  </Container>
</header>

<style>
  .bar,
  .header-right,
  nav,
  .controls {
    display: flex;
    align-items: baseline;
  }
  .bar {
    justify-content: space-between;
    gap: 1.5rem;
  }
  .header-right,
  nav { gap: 1.375rem; }
  .controls { align-items: center; gap: 0.5rem; }
  :global(.home-link) { color: var(--foreground) !important; }
  :global(.home-link:hover) { color: var(--primary) !important; }
  :global(.nav-link) {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-bottom: 0.1875rem;
    color: var(--muted-foreground) !important;
    font-family: var(--font-sans);
    font-size: 0.84375rem;
    font-weight: 500;
    transition: color 180ms ease;
  }
  :global(.nav-link:hover),
  :global(.nav-link.active) { color: var(--foreground) !important; }
  .active-line {
    position: absolute;
    right: -0.1875rem;
    bottom: 0;
    left: -0.1875rem;
    height: 1px;
    background: var(--primary);
  }
  .nav-icon { width: 0.875rem; height: 0.875rem; flex: none; }
  @media (width < 48rem), (pointer: coarse) {
    :global(.home-link), :global(.nav-link) { display: inline-flex !important; min-width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center; }
  }
  @media (width <= 45rem) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "wordmark controls"
        "nav nav";
      align-items: center;
      column-gap: 0.875rem;
      row-gap: 0.875rem;
    }
    :global(.home-link) { grid-area: wordmark; justify-self: start; }
    .header-right { display: contents; }
    nav { grid-area: nav; flex-wrap: wrap; justify-content: flex-start; }
    .controls { grid-area: controls; justify-self: end; }
    :global(.nav-link) { padding-top: 0.375rem; }
  }
  @media (width < 30rem) {
    .bar { row-gap: 0.75rem; }
    nav { gap: 1.125rem; }
    :global(.nav-link) { font-size: 0.78125rem; }
    .nav-icon { display: none; }
    .controls { gap: 0.375rem; }
  }
  @media (width < 23rem) {
    .bar {
      grid-template-columns: 1fr;
      grid-template-areas: "wordmark" "controls" "nav";
    }
    .controls { justify-self: start; }
  }
</style>

---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import "@/styles/tokens.css";
import "@/styles/reset.css";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  markdown?: string;
}

const {
  title = config.site.title,
  description = config.metadata.meta_description,
  image = "/og.jpg",
  noindex = false,
  type = "website",
  markdown,
} = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="zh-Hant" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.metadata.meta_author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href={config.site.favicon} />
    <link rel="icon" type="image/svg+xml" href={config.site.favicon_dark} media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="Vartifact RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="article:author" content={config.metadata.meta_author} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={config.metadata.meta_author} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        document.documentElement.classList.toggle(
          "dark",
          theme === "dark" ||
            (theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches),
        );
        const font = localStorage.getItem("font") === "sans" ? "sans" : "serif";
        document.documentElement.classList.toggle("reading-sans", font === "sans");

        const fontFamily = font === "sans" ? "Huninn" : "Iansui";
        const fontStylesheet = document.createElement("link");
        fontStylesheet.rel = "preload";
        fontStylesheet.as = "style";
        fontStylesheet.fetchPriority = "low";
        fontStylesheet.href = `https://fonts.googleapis.com/css2?family=${fontFamily}&display=swap`;
        fontStylesheet.dataset.readingFont = font;
        fontStylesheet.addEventListener("load", () => {
          fontStylesheet.rel = "stylesheet";
          fontStylesheet.dataset.loaded = "true";
        }, { once: true });
        document.head.append(fontStylesheet);
      } catch {}
    </script>
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Iansui&display=swap" /></noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到主要內容</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <a href="/_emdash/admin" class="admin-shortcut" aria-label="開啟管理後台"></a>
    <script>
      import { toggleTheme } from "@/lib/theme";

      const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      let storedTheme: string | null = null;
      try { storedTheme = localStorage.getItem("theme"); } catch {}
      let activeTheme =
        storedTheme === "light" || storedTheme === "dark" ? storedTheme : "system";
      const systemTheme = matchMedia("(prefers-color-scheme: dark)");
      const updateThemeButton = () => {
        if (!themeButton) return;
        const isDark = document.documentElement.classList.contains("dark");
        const targetTheme = isDark ? "淺色" : "深色";
        const label = themeButton.querySelector<HTMLElement>("[data-theme-label]");
        const status = themeButton.querySelector<HTMLElement>("[data-theme-status]");
        if (label) label.textContent = targetTheme;
        if (status) status.textContent = `目前使用${isDark ? "深色" : "淺色"}主題`;
        themeButton.setAttribute("aria-label", `切換為${targetTheme}主題`);
        themeButton.title = `切換為${targetTheme}主題`;
      };
      const applyTheme = () => {
        toggleTheme(activeTheme === "dark" || (activeTheme === "system" && systemTheme.matches));
        updateThemeButton();
      };
      systemTheme.addEventListener("change", () => {
        if (activeTheme === "system") applyTheme();
      });
      applyTheme();
      themeButton?.addEventListener("click", () => {
        activeTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
        try { localStorage.setItem("theme", activeTheme); } catch {}
        applyTheme();
      });

      const fontButton = document.querySelector<HTMLButtonElement>("[data-font-toggle]");
      if (fontButton) {
        let font = document.documentElement.classList.contains("reading-sans") ? "sans" : "serif";
        const loadFont = (nextFont: "serif" | "sans") =>
          new Promise<void>((resolve) => {
            const selector = `link[data-reading-font="${nextFont}"]`;
            const existing = document.querySelector<HTMLLinkElement>(selector);
            if (existing?.dataset.loaded === "true" || existing?.sheet) {
              resolve();
              return;
            }

            const link = existing ?? document.createElement("link");
            const finish = () => {
              link.dataset.loaded = "true";
              resolve();
            };
            link.addEventListener("load", finish, { once: true });
            link.addEventListener("error", finish, { once: true });
            if (!existing) {
              const fontFamily = nextFont === "sans" ? "Huninn" : "Iansui";
              link.rel = "stylesheet";
              link.href = `https://fonts.googleapis.com/css2?family=${fontFamily}&display=swap`;
              link.dataset.readingFont = nextFont;
              document.head.appendChild(link);
            }
          });
        const updateFontButton = () => {
          const targetFont = font === "serif" ? "黑體" : "襯體";
          const label = fontButton.querySelector<HTMLElement>("[data-font-label]");
          const status = document.querySelector<HTMLElement>("[data-font-status]");
          if (label) label.textContent = targetFont;
          if (status) status.textContent = `目前使用${font === "serif" ? "Iansui 襯體" : "Huninn 黑體"}`;
          fontButton.title = `切換為${targetFont}`;
        };
        updateFontButton();
        fontButton.addEventListener("click", async () => {
          const nextFont = font === "serif" ? "sans" : "serif";
          const status = document.querySelector<HTMLElement>("[data-font-status]");
          fontButton.disabled = true;
          fontButton.setAttribute("aria-busy", "true");
          if (status) status.textContent = `正在載入${nextFont === "serif" ? "Iansui 襯體" : "Huninn 黑體"}`;
          await loadFont(nextFont);
          const fontFamily = nextFont === "serif" ? "Iansui" : "Huninn";
          try {
            await document.fonts.load(`1em "${fontFamily}"`, document.body.textContent ?? "");
          } catch {}
          font = nextFont;
          try { localStorage.setItem("font", font); } catch {}
          document.documentElement.classList.toggle("reading-sans", font === "sans");
          fontButton.disabled = false;
          fontButton.removeAttribute("aria-busy");
          updateFontButton();
        });
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>(
        "[data-back-to-prev]",
      )) {
        const sameOrigin = (() => {
          try {
            return new URL(document.referrer).origin === location.origin;
          } catch {
            return false;
          }
        })();
        const label = button.querySelector<HTMLElement>("[data-back-label]");
        if (label) label.textContent = sameOrigin ? "回上一頁" : "前往文章列表";
        button.addEventListener("click", () => {
          if (sameOrigin) history.back();
          else location.href = "/blog";
        });
      }
    </script>
    <script is:inline>
      const updateScrollState = () =>
        document.documentElement.classList.toggle("scrolled", window.scrollY > 0);
      updateScrollState();
      addEventListener("scroll", updateScrollState, { passive: true });
      const header = document.querySelector("header");
      if (header) {
        new ResizeObserver(() => {
          document.documentElement.style.setProperty("--header-height", `${header.getBoundingClientRect().height}px`);
        }).observe(header);
      }
    </script>
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"c617e67a33d54b69bae259d6a61d45b3"}'></script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--foreground);
    color: var(--background);
    transform: translateY(-150%);
  }
  .skip-link:focus { transform: none; }
  .admin-shortcut {
    position: fixed;
    z-index: 100;
    bottom: 0;
    left: 0;
    display: block;
    width: 10px;
    height: 10px;
    background: transparent;
  }
</style>

{
  "name": "site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run format:check && npm run lint && npm run check:astro",
    "check:astro": "astro check",
    "check:watch": "astro check --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/react": "^6.0.4",
    "@emdash-cms/cloudflare": "^0.35.0",
    "@emdash-cms/plugin-forms": "^0.2.5",
    "astro": "^7.2.7",
    "emdash": "^0.35.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify/json": "^2.2.518",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "undici": "7.29.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  },
  "emdash": {
    "seed": ".emdash/seed.json"
  }
}
